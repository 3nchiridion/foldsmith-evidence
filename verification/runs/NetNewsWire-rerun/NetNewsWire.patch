diff --git a/iOS/Duo/DuoFold.swift b/iOS/Duo/DuoFold.swift
new file mode 100644
index 0000000..dc894a6
--- /dev/null
+++ b/iOS/Duo/DuoFold.swift
@@ -0,0 +1,37 @@
+//
+//  DuoFold.swift
+//  NetNewsWire-iOS
+//
+//  iPhone Duo: what the window's fold and vertical bar are doing, read from the reserved regions
+//  and the trait collection (never from the device, its idiom or its orientation).
+//  Everything here is a no-op before iOS 27.1 and wherever the window has no fold.
+//
+
+import UIKit
+
+extension Notification.Name {
+
+	/// Posted by the root split view controller when its window gains or loses a fold,
+	/// or when a fold turns active or inactive (the iPhone Duo's hinge moved).
+	static let windowFoldDidChange = Notification.Name("WindowFoldDidChange")
+}
+
+extension UIView {
+
+	/// True where the window has a fold, active or not (the iPhone Duo's inner display).
+	/// Read from the window, since a pane beside the fold (a detail that starts where the fold ends) reports none.
+	var windowHasFold: Bool {
+		guard #available(iOS 27.1, *) else {
+			return false
+		}
+		return !(window ?? self).reservedRegions(kind: .division, options: .includeInactive).isEmpty
+	}
+
+	/// True while a fold that runs top to bottom is active: the iPhone Duo folded like a book. Read from the window.
+	var isBookFoldActive: Bool {
+		guard #available(iOS 27.1, *) else {
+			return false
+		}
+		return (window ?? self).reservedRegions(kind: .division).contains { $0.isActive && $0.frame.height > $0.frame.width }
+	}
+}
diff --git a/iOS/Duo/FoldAwareSheets.swift b/iOS/Duo/FoldAwareSheets.swift
new file mode 100644
index 0000000..83c630f
--- /dev/null
+++ b/iOS/Duo/FoldAwareSheets.swift
@@ -0,0 +1,39 @@
+//
+//  FoldAwareSheets.swift
+//  NetNewsWire-iOS
+//
+//  iPhone Duo: the sheet rule. Folded like a book, the system puts a sheet on the leading half, over the list;
+//  Apple sends alerts and sheets to the trailing half there. Elsewhere sheets go where the system puts them.
+//
+
+import UIKit
+
+extension UIViewController {
+
+	/// The sheet rule for the iPhone Duo: a sheet sits on the trailing half while the book fold is active,
+	/// away from the list on the leading half, and where the system puts it everywhere else.
+	/// Call it before presenting, with the controller about to be presented.
+	func applyFoldAwareSheetPlacement(to presented: UIViewController) {
+		guard #available(iOS 27.1, *), let sheet = presented.sheetPresentationController else {
+			return
+		}
+		sheet.preferredPlacement = view.isBookFoldActive ? .trailing : .automatic
+	}
+
+	/// Moves the sheets already up (this controller's presented chain) to the side the fold calls for.
+	func updateFoldAwareSheetPlacement() {
+		guard #available(iOS 27.1, *) else {
+			return
+		}
+		let placement: UISheetPresentationController.Placement = view.isBookFoldActive ? .trailing : .automatic
+		var presented = presentedViewController
+		while let controller = presented {
+			if !controller.isBeingDismissed, let sheet = controller.sheetPresentationController, sheet.preferredPlacement != placement {
+				sheet.animateChanges {
+					sheet.preferredPlacement = placement
+				}
+			}
+			presented = controller.presentedViewController
+		}
+	}
+}
diff --git a/iOS/Duo/VerticalBarReader.swift b/iOS/Duo/VerticalBarReader.swift
new file mode 100644
index 0000000..e47f94f
--- /dev/null
+++ b/iOS/Duo/VerticalBarReader.swift
@@ -0,0 +1,33 @@
+//
+//  VerticalBarReader.swift
+//  NetNewsWire-iOS
+//
+//  iPhone Duo: tells a SwiftUI view whether its bars are vertical (`toolbarVerticalEdge`, iOS 27.1),
+//  so a bar item can carry a symbol and a title there and stay as it was everywhere else.
+//
+
+import SwiftUI
+
+struct VerticalBarReader<Content: View>: View {
+
+	@ViewBuilder let content: (_ hasVerticalBar: Bool) -> Content
+
+	var body: some View {
+		if #available(iOS 27.1, *) {
+			VerticalBarEdgeReader(content: content)
+		} else {
+			content(false)
+		}
+	}
+}
+
+@available(iOS 27.1, *)
+private struct VerticalBarEdgeReader<Content: View>: View {
+
+	@Environment(\.toolbarVerticalEdge) private var verticalEdge
+	let content: (Bool) -> Content
+
+	var body: some View {
+		content(verticalEdge != nil)
+	}
+}
