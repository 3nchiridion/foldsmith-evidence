diff --git a/iOS/RootSplitViewController.swift b/iOS/RootSplitViewController.swift
index 52a425e..b8b67c6 100644
--- a/iOS/RootSplitViewController.swift
+++ b/iOS/RootSplitViewController.swift
@@ -26,6 +26,102 @@ final class RootSplitViewController: UISplitViewController {
 		coordinator.resetFocus()
 	}
 
+	// MARK: iPhone Duo
+
+	/// True while the window has a fold and the system, not the app, sizes the columns.
+	private(set) var isFoldSizingColumns = false
+	private var isBookFoldActive = false
+	private var appColumnWidths: ColumnWidths?
+
+	/// Narrowest the detail may be where the window has a fold, so the timeline tiles beside it
+	/// in the 669 pt upright inner display instead of leaving the detail alone.
+	private static let minimumSecondaryColumnWidthOnFoldingDisplay: CGFloat = 320
+
+	/// The widths the app sets (SceneCoordinator), kept while the fold sizes the columns.
+	private struct ColumnWidths {
+		let minimumPrimary: CGFloat
+		let maximumPrimary: CGFloat
+		let preferredPrimary: CGFloat
+		let minimumSupplementary: CGFloat
+		let maximumSupplementary: CGFloat
+		let preferredSupplementary: CGFloat
+		let minimumSecondary: CGFloat?
+	}
+
+	override func viewDidLoad() {
+		super.viewDidLoad()
+		if #available(iOS 27.1, *) {
+			// UIKit has no callback when the reserved regions change: look again whenever the hinge moves,
+			// and once more when the regions have had time to arrive (they come 0.1–0.3 s after a change).
+			view.addInteraction(UIHingeInteraction { [weak self] _, _ in
+				self?.view.setNeedsLayout()
+				DispatchQueue.main.asyncAfter(deadline: .now() + 0.35) { [weak self] in
+					self?.view.setNeedsLayout()
+				}
+			})
+		}
+	}
+
+	override func viewWillLayoutSubviews() {
+		// Before super: the split resolves its columns and display mode in this pass.
+		updateColumnsForFold()
+		super.viewWillLayoutSubviews()
+	}
+
+	/// Where the window has a fold, set no column width, so the system puts the boundary on the fold,
+	/// and let the detail be narrow enough to tile beside the timeline held upright.
+	/// Without a fold, the app's own widths are back.
+	private func updateColumnsForFold() {
+		let hasFold = view.windowHasFold
+		let bookFold = view.isBookFoldActive
+		defer {
+			if hasFold != isFoldSizingColumns || bookFold != isBookFoldActive {
+				isFoldSizingColumns = hasFold
+				isBookFoldActive = bookFold
+				NotificationCenter.default.post(name: .windowFoldDidChange, object: self)
+				// Sheets already up move to the side the fold now calls for.
+				updateFoldAwareSheetPlacement()
+			}
+		}
+		guard hasFold != isFoldSizingColumns else {
+			return
+		}
+		if hasFold {
+			var minimumSecondary: CGFloat?
+			if #available(iOS 26, *) {
+				minimumSecondary = minimumSecondaryColumnWidth
+			}
+			appColumnWidths = ColumnWidths(minimumPrimary: minimumPrimaryColumnWidth,
+										   maximumPrimary: maximumPrimaryColumnWidth,
+										   preferredPrimary: preferredPrimaryColumnWidth,
+										   minimumSupplementary: minimumSupplementaryColumnWidth,
+										   maximumSupplementary: maximumSupplementaryColumnWidth,
+										   preferredSupplementary: preferredSupplementaryColumnWidth,
+										   minimumSecondary: minimumSecondary)
+			let automatic = UISplitViewController.automaticDimension
+			minimumPrimaryColumnWidth = automatic
+			maximumPrimaryColumnWidth = automatic
+			preferredPrimaryColumnWidth = automatic
+			minimumSupplementaryColumnWidth = automatic
+			maximumSupplementaryColumnWidth = automatic
+			preferredSupplementaryColumnWidth = automatic
+			if #available(iOS 26, *) {
+				minimumSecondaryColumnWidth = Self.minimumSecondaryColumnWidthOnFoldingDisplay
+			}
+		} else if let appColumnWidths {
+			minimumPrimaryColumnWidth = appColumnWidths.minimumPrimary
+			maximumPrimaryColumnWidth = appColumnWidths.maximumPrimary
+			preferredPrimaryColumnWidth = appColumnWidths.preferredPrimary
+			minimumSupplementaryColumnWidth = appColumnWidths.minimumSupplementary
+			maximumSupplementaryColumnWidth = appColumnWidths.maximumSupplementary
+			preferredSupplementaryColumnWidth = appColumnWidths.preferredSupplementary
+			if #available(iOS 26, *), let minimumSecondary = appColumnWidths.minimumSecondary {
+				minimumSecondaryColumnWidth = minimumSecondary
+			}
+			self.appColumnWidths = nil
+		}
+	}
+
 	/// Show a column for programmatic navigation.
 	/// Pass `bypassDisplayModeRestriction: true` for user-initiated navigation, so it can
 	/// reveal a column the display-mode suppression below would otherwise keep hidden.
